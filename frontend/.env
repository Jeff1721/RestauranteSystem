# ─── RestauranteSystem — Variables de entorno Frontend ───────────────────────
# Copia este archivo como .env y ajusta los valores según tu entorno

# URL base de la API (sin barra al final)
REACT_APP_API_URL=http://localhost:3000/api

# Nombre del restaurante (se muestra en el sidebar y facturas)
REACT_APP_NOMBRE_RESTAURANTE=Mi Restaurante

# Moneda (símbolo que se muestra en precios y facturas)
REACT_APP_MONEDA=₡

# Porcentaje de impuesto (ej: 13 para IVA Costa Rica)
REACT_APP_IMPUESTO=13
